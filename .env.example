# =============================================================
# Flask
# =============================================================
# Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Set to 1 in production (requires HTTPS). Also enables HSTS, force-https,
# and Secure cookies via Flask-Talisman. Leave 0 for local HTTP dev.
SESSION_COOKIE_SECURE=0

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# bcrypt cost factor. 12 is the recommended floor for 2026 hardware.
BCRYPT_LOG_ROUNDS=12

# Rate-limit storage. Defaults to in-memory (single-process only — breaks
# under `gunicorn -w 4`). Production: point at Redis/Memcached.
# Example: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# =============================================================
# MySQL database
# =============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ERP

# =============================================================
# SMTP (Gmail App Password required)
# Setup: https://support.google.com/accounts/answer/185833
# =============================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=15
EMAIL_ADDRESS=your-erp-mailer@gmail.com
EMAIL_PASSWORD=your-16-char-gmail-app-password
# 1 to send synchronously (blocks the request); 0 sends on a daemon thread.
EMAIL_SEND_SYNC=0
